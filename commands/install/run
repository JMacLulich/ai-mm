#!/usr/bin/env bash
#
# Install command for claude-mm-tool
#
# Installs the ai tool to ~/.local/bin with proper venv

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

usage() {
    cat <<EOF
Usage: ./run install [OPTIONS]

Install claude-mm-tool to ~/.local/bin

Options:
  --help    Show this help message

Provider credentials are managed by llm-router, not this installer.
EOF
}

check_dependencies() {
    if ! command -v python3 &> /dev/null; then
        echo "Error: python3 is not installed" >&2
        exit 1
    fi

    # Check for venv module (often missing on minimal Debian/Ubuntu)
    if ! python3 -m venv --help &> /dev/null; then
        echo "Error: Python 'venv' module is missing." >&2
        echo "  On Ubuntu/Debian, please run: sudo apt install python3-venv" >&2
        exit 1
    fi
}

check_path() {
    local bin_dir="$HOME/.local/bin"
    if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
        echo ""
        echo "⚠️  Warning: $bin_dir is not in your PATH."
        echo "   To use the 'ai' command, add this to your ~/.bashrc or ~/.profile:"
        echo "     export PATH=\"$bin_dir:\$PATH\""
    fi
}

main() {
    check_dependencies
    cd "$ROOT"

    if [[ "${1:-}" == "--help" ]]; then
        usage
        exit 0
    fi

    echo "📦 Installing claude-mm-tool..."

    # Create ~/.local/bin if it doesn't exist
    mkdir -p "$HOME/.local/bin"

    # Create venv at ~/.local/venvs/ai
    local venv_dir="$HOME/.local/venvs/ai"
    local package_source
    if [[ -n "${AI_MM_INSTALL_ARTIFACT:-}" ]]; then
        if [[ ! -f "$AI_MM_INSTALL_ARTIFACT" ]]; then
            echo "Error: AI_MM_INSTALL_ARTIFACT does not exist: $AI_MM_INSTALL_ARTIFACT" >&2
            exit 1
        fi
        package_source="$AI_MM_INSTALL_ARTIFACT"
    else
        package_source="${ROOT}[dev]"
    fi

    if [[ ! -d "$venv_dir" ]]; then
        echo "🐍 Creating Python virtual environment..."
        python3 -m venv "$venv_dir"
    fi

    # Install a self-contained package copy. Editable installs leave the global
    # command dependent on the lifetime of the checkout that ran this script;
    # deleting a temporary worktree then makes every `ai` invocation fail.
    echo "📚 Installing dependencies..."
    "$venv_dir/bin/pip" install -q --upgrade pip
    # pip builds the wheel before replacing the prior installation. Installing
    # the dev extra once is equivalent to the old redundant base + dev pair.
    # A prebuilt artifact may be supplied for offline/reproducible installation.
    "$venv_dir/bin/pip" install -q --upgrade --force-reinstall "$package_source"
    # Dependency removals are not pruned by a pip upgrade.
    "$venv_dir/bin/pip" uninstall -q -y anthropic google-genai >/dev/null 2>&1 || true

    # set -e makes this a fail-closed postcondition for the installed package.
    "$venv_dir/bin/python3" -m claude_mm.install_verify

    # Copy ai script to ~/.local/bin with venv shebang
    echo "🔧 Installing ai command..."
    local ai_bin="$HOME/.local/bin/ai"
    cp "$ROOT/bin/ai" "$ai_bin"

    # Update shebang to use venv Python
    sed -i.bak "1s|.*|#!$venv_dir/bin/python3|" "$ai_bin"
    rm "$ai_bin.bak"
    chmod +x "$ai_bin"

    # Install Carapace completion if .carapace spec exists
    if [[ -f "$ROOT/.carapace/ai.yaml" ]]; then
        echo "🎯 Installing shell completions..."
        mkdir -p "$HOME/.config/carapace/specs"
        cp "$ROOT/.carapace/ai.yaml" "$HOME/.config/carapace/specs/"

        # macOS Carapace may prefer Library/Application Support path.
        local mac_specs_dir="$HOME/Library/Application Support/carapace/specs"
        mkdir -p "$mac_specs_dir"
        cp "$ROOT/.carapace/ai.yaml" "$mac_specs_dir/"
        echo "  ✓ ai.yaml"
    fi

    # Install the canonical review skills for both Claude and the shared
    # ~/.agents discovery root used by Codex.  Keeping only the Claude copy
    # left Codex on an obsolete LM Studio/Ollama-era skill indefinitely.
    local skill_name skills_root skill_source skill_target managed_marker
    local skill_tmp marker_tmp
    for skill_name in mm-review mm-review-loop; do
        skill_source="$ROOT/claude/skills/$skill_name"
        [[ -d "$skill_source" ]] || continue
        echo "🔧 Installing $skill_name skill..."
        for skills_root in "$HOME/.claude/skills" "$HOME/.agents/skills"; do
            skill_target="$skills_root/$skill_name"
            if [[ -L "$skill_target" ]]; then
                # unlink removes the directory entry itself and never follows
                # the link into another owner's target directory.
                unlink "$skill_target"
            elif [[ -e "$skill_target" && ! -d "$skill_target" ]]; then
                echo "  ⚠ Skipping unmanaged non-directory: ${skill_target/#$HOME/\~}" >&2
                continue
            elif [[ -d "$skill_target" ]]; then
                managed_marker="$skill_target/.ai-mm-managed"
                if [[ -L "$managed_marker" || -L "$skill_target/SKILL.md" ]]; then
                    echo "  ⚠ Skipping skill with nested symlink: ${skill_target/#$HOME/\~}" >&2
                    continue
                elif [[ -f "$managed_marker" ]]; then
                    if [[ "$(<"$managed_marker")" != "managed-by=ai-mm" ]]; then
                        echo "  ⚠ Skipping skill with invalid ownership marker: ${skill_target/#$HOME/\~}" >&2
                        continue
                    fi
                else
                    # Safely adopt historical ai-mm installs, which contained
                    # exactly SKILL.md. Any additional entry means another
                    # owner may have customized the skill, so leave it alone.
                    if ! (
                        shopt -s nullglob dotglob
                        entries=("$skill_target"/*)
                        (( ${#entries[@]} == 0 )) || {
                            (( ${#entries[@]} == 1 )) &&
                            [[ "${entries[0]}" == "$skill_target/SKILL.md" ]] &&
                            [[ -f "${entries[0]}" && ! -L "${entries[0]}" ]]
                        }
                    ); then
                        echo "  ⚠ Skipping unmanaged customized skill: ${skill_target/#$HOME/\~}" >&2
                        continue
                    fi
                fi
            fi
            mkdir -p "$skill_target"
            # Build regular files with O_EXCL-backed mktemp paths, then rename
            # them over the directory entries. This cannot follow a stale or
            # concurrently introduced SKILL.md/marker symlink into another
            # owner's file.
            skill_tmp="$(mktemp "$skill_target/.SKILL.md.XXXXXX")"
            marker_tmp="$(mktemp "$skill_target/.ai-mm-managed.XXXXXX")"
            cp "$skill_source/SKILL.md" "$skill_tmp"
            printf 'managed-by=ai-mm\n' > "$marker_tmp"
            chmod 0644 "$skill_tmp" "$marker_tmp"
            mv -f "$skill_tmp" "$skill_target/SKILL.md"
            mv -f "$marker_tmp" "$skill_target/.ai-mm-managed"
            echo "  ✓ Skill installed to ${skill_target/#$HOME/\~}/"
        done
    done

    local config_dir="$HOME/.config/ai-mm"
    mkdir -p "$config_dir"

    echo ""
    echo "✅ Installation complete!"
    echo ""
    echo "   Command: ai"
    echo "   Location: $ai_bin"
    echo "   Router: ${LLM_ROUTER_BASE_URL:-http://127.0.0.1:4000/v1}"
    
    check_path
    
    echo ""
    echo "Try: ai --help"
}

main "$@"
